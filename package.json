{
  "name": "zviratka-ai",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "A tiny neural network that learns Czech <-> English animal names, trained live in the browser.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "validate-data": "tsx scripts/validate-data.ts",
    "bake": "tsx scripts/bake-replay.ts",
    "e2e": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
